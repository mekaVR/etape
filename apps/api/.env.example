# JWT
JWT_SECRET=JWT-secret
JWT_REFRESH_SECRET=JWT-refresh-secret
JWT_EXPIRES_IN=JWT-expire
JWT_REFRESH_EXPIRES_IN=JWT-refresh-expire
REFRESH_TOKEN_MAX_AGE=refresh-token-max-age

# App
NODE_ENV=development

# Database
DATABASE_URL=database-url

# External APIs
INSEE_API_URL=https://api.insee.fr/api-sirene/3.11
INSEE_API_KEY=
GOUV_API_URL=

# Mailer
MAIL_HOST=host
MAIL_PORT=port
MAIL_USER=user
MAIL_PASSWORD=password
MAIL_FROM=from
MAIL_LOGO_URL=logo-url

# Front URL utilisée pour construire le lien de reset
APP_URL=app-url

#CORS
CORS_ORIGINS=url

# Password reset
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# Email verification
EMAIL_VERIFICATION_TOKEN_TTL_MS=345600000